# Ditto Cloud Environment Configuration
# Copy this file to .env and modify as needed
# cp .env.example .env

# ========================================
# Admin Initialization (First Run)
# ========================================
# If no users exist, these env vars auto-create the first admin account.
# After the first admin is created, set these to empty or remove them.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-secure-password
# ADMIN_EMAIL=admin@example.com

# ========================================
# Backend Configuration
# ========================================
PORT=8080
DATABASE_PATH=/app/data/ditto_cloud.db
LOG_LEVEL=info  # debug, info, warn, error

# ========================================
# JWT Authentication
# ========================================
# Generate with: openssl rand -base64 32
# The server refuses to start with a secret shorter than 32 bytes.
# IMPORTANT: Change this in production! (docs/DEPLOYMENT_GUIDE.md sed-replaces
# the "change-me-in-production" prefix, so keep it if you edit the length.)
JWT_SECRET=change-me-in-production-with-at-least-32-bytes

# JWT Token expiration (minutes)
JWT_ACCESS_TOKEN_EXPIRY=15
JWT_REFRESH_TOKEN_EXPIRY=10080  # 7 days

# ========================================
# Database Configuration (Optional)
# ========================================
# For SQLite (default):
# DATABASE_URL not required

# For PostgreSQL (multi-user):
# DATABASE_URL=postgresql://user:password@postgres-host:5432/ditto_db
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME=300

# ========================================
# TLS/SSL Configuration (Production)
# ========================================
# Uncomment and set paths for HTTPS
# TLS_CERT=/app/certs/server.crt
# TLS_KEY=/app/certs/server.key

# ========================================
# Security Settings
# ========================================
# Maximum clip size in bytes (default: 10MB)
MAX_CLIP_SIZE=10485760

# Rate limiting
RATE_LIMIT_LOGIN=5          # attempts per minute
RATE_LIMIT_API=60           # requests per minute
RATE_LIMIT_BAN_DURATION=900 # ban duration in seconds (15 minutes)

# ========================================
# Sync Configuration
# ========================================
# Background sync interval (seconds)
SYNC_INTERVAL=30

# Maximum clips per user
MAX_CLIPS_PER_USER=10000

# Auto-delete clips after days (0 = disabled)
AUTO_DELETE_DAYS=90

# ========================================
# Encryption Settings
# ========================================
# Enable end-to-end encryption (1 = enabled, 0 = disabled)
ENCRYPTION_ENABLED=1

# PBKDF2 iterations for key derivation
PBKDF2_ITERATIONS=100000

# ========================================
# Storage Settings
# ========================================
# Maximum storage per user (MB)
MAX_STORAGE_MB=500

# Enable file sync (CF_HDROP - paths only, not file content)
FILE_SYNC_ENABLED=1

# ========================================
# WebSocket Settings
# ========================================
# WebSocket ping interval (seconds)
WS_PING_INTERVAL=30

# WebSocket read timeout (seconds)
WS_READ_TIMEOUT=86400

# ========================================
# CORS Configuration (Optional)
# ========================================
# Comma-separated list of allowed origins
# CORS_ALLOWED_ORIGINS=https://ditto.example.com,https://admin.example.com

# ========================================
# Email Notifications (Optional)
# ========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@your-domain.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@your-domain.com

# ========================================
# Logging Configuration
# ========================================
# Log format: json, console
LOG_FORMAT=json

# Log file path (optional, logs to stdout by default)
# LOG_FILE=/app/logs/ditto.log

# Max log file size (MB)
LOG_MAX_SIZE=100

# Max log files to keep
LOG_MAX_BACKUPS=5
