# Ditto Cloud Environment Configuration
# Copy this file to .env and modify as needed
# cp .env.example .env
#
# Only variables actually read by the server are listed here.
# Anything not listed below is ignored by the backend.

# ========================================
# Admin Initialization (First Run)
# ========================================
# If no users exist, these env vars auto-create the first admin account.
# Keep them commented out to skip auto-seeding. A placeholder password
# (containing "change-me") makes the server refuse to start.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-admin-password
# ADMIN_EMAIL=admin@example.com

# ========================================
# Backend Configuration
# ========================================
PORT=8080
DATABASE_PATH=/app/data/ditto_cloud.db

# GORM log level: info, warn, error, silent (default: warn)
# GORM_LOG_LEVEL=warn

# ========================================
# JWT Authentication
# ========================================
# Generate with: openssl rand -hex 32
# The server refuses to start with a secret shorter than 32 bytes or with the
# placeholder below left unchanged.
JWT_SECRET=change-me

# JWT Token expiration (minutes)
JWT_ACCESS_TOKEN_EXPIRY=15
JWT_REFRESH_TOKEN_EXPIRY=10080  # 7 days

# ========================================
# TLS/SSL Configuration (Production)
# ========================================
# When TLS_CERT is empty the server assumes HTTP dev mode and disables the
# Secure cookie flag. Set both paths to enable HTTPS.
# TLS_CERT=/app/certs/server.crt
# TLS_KEY=/app/certs/server.key

# Set to true/1 only for local HTTP development behind no proxy.
# INSECURE_COOKIES=false

# ========================================
# CORS / WebSocket Origins
# ========================================
# Comma-separated list of extra allowed origins, e.g.
# https://ditto.example.com,https://admin.example.com
# Leave empty for same-origin deployments: requests whose Origin matches the
# serving Host are always accepted; anything else is rejected.
# ALLOWED_ORIGINS=

# ========================================
# Clips & Sync
# ========================================
# Maximum clips pushed in a single sync request (default: 1000)
# MAX_PUSH_LIMIT=1000

# Default / maximum clips returned per pull request
# SYNC_DEFAULT_PULL_LIMIT=1000
# SYNC_MAX_PULL_LIMIT=5000

# Maximum clips kept per user (default: 1000)
# MAX_CLIPS_PER_USER=1000

# Maximum age of clips before removal, Go duration (default: 720h = 30 days)
# MAX_CLIP_AGE=720h

# How often the cleanup job runs, Go duration (default: 24h)
# CLEANUP_INTERVAL=24h

# How long soft-deleted records are kept before hard delete (default: 2160h = 90 days)
# SOFT_DELETE_RETENTION=2160h

# Per-user storage quota in MB (default: 100)
# STORAGE_QUOTA_MB=100

# Slow query threshold for the database log, Go duration (default: 500ms)
# DB_SLOW_THRESHOLD=500ms
