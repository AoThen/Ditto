# Ditto Cloud Server Configuration

# Server port (default: 8080)
PORT=8080

# SQLite database path (default: ./data/ditto_cloud.db)
DATABASE_PATH=./data/ditto_cloud.db

# JWT signing secret
# If not set, a cryptographically random secret will be auto-generated
# and persisted to ./data/.jwt_secret. For production, set this explicitly
# to a strong random value: the server exits at startup if it is shorter
# than 32 bytes. Generate one with `openssl rand -hex 32`.
# JWT_SECRET=

# Cookie security: set to "true" to disable Secure flag for HTTP dev
# INSECURE_COOKIES=true

# Cleanup settings
# CLEANUP_INTERVAL=24h
# MAX_CLIP_AGE=720h
# MAX_CLIPS_PER_USER=1000

# CORS allowed origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# TLS (optional - if both are set, server uses HTTPS)
# TLS_CERT=/path/to/cert.pem
# TLS_KEY=/path/to/key.pem
